# Postgres — Supabase project Postgres URL (Project Settings → Database → Connection string → URI),
# or a local Postgres for development. NOTE: driver must be `postgresql+asyncpg`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/standfast

# Supabase — used to verify JWTs from the frontend and (later) for admin API calls.
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API → JWT Settings → JWT Secret (HS256). This MUST stay server-side.
SUPABASE_JWT_SECRET=replace-me
# Project Settings → API → service_role. This MUST stay server-side — never ship to the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
